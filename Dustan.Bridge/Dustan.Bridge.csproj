<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Service process for the Qt Quick desktop app. It owns the music index, video catalog,
    TV schedules and music playback, and speaks newline-delimited JSON on stdin/stdout.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dustan.Bridge</RootNamespace>
    <AssemblyName>Dustan.Bridge</AssemblyName>
    <Version>2.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dustan.Core\Dustan.Core.csproj" />
  </ItemGroup>
</Project>
