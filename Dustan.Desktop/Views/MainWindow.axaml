<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Dustan.Controls"
        x:Class="Dustan.Views.MainWindow"
        Title="Dustan"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <controls:TransportBar x:Name="Transport" DockPanel.Dock="Bottom" />

        <Grid ColumnDefinitions="220,*">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Dustan" />
                    <TextBox x:Name="SearchBox"
                             Watermark="Search title, artist, album"
                             TextChanged="SearchBox_TextChanged" />
                </StackPanel>
                <ListBox x:Name="NavList"
                         SelectionChanged="NavList_SelectionChanged"
                         Margin="8,0,8,8">
                    <ListBoxItem Tag="albums" Content="Albums" />
                    <ListBoxItem Tag="artists" Content="Artists" />
                    <ListBoxItem Tag="tracks" Content="Tracks" />
                    <ListBoxItem Tag="library" Content="Library" />
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <Button x:Name="BackButton"
                        DockPanel.Dock="Top"
                        HorizontalAlignment="Left"
                        Margin="12,8,12,0"
                        Content="Back"
                        Click="BackButton_Click"
                        IsVisible="False" />
                <ContentControl x:Name="ContentHost" Margin="0,4,0,0" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
