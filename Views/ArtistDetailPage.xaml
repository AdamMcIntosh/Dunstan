<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dustan.Views.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Dustan.Helpers"
    xmlns:models="using:Dustan.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Name="ArtistTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="ArtistMeta" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button HorizontalAlignment="Left" Click="PlayAll_Click" Content="Play all" />
            </StackPanel>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Albums" />
            <GridView
                x:Name="AlbumGrid"
                IsItemClickEnabled="True"
                ItemClick="AlbumGrid_ItemClick"
                SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="helpers:AlbumCard">
                        <StackPanel Width="140" Margin="6" Spacing="4">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="EditAlbum_Click" Tag="{x:Bind}" Text="Edit album metadata" />
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Border Width="140" Height="140" CornerRadius="4">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind Artwork}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Album.Name}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Tracks" />
            <ListView
                x:Name="TrackList"
                IsItemClickEnabled="False"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackInfo">
                        <Grid Padding="0,4" ColumnSpacing="12">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="EditTrack_Click" Tag="{x:Bind}" Text="Edit metadata" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Album}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Text="{x:Bind DurationDisplay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
