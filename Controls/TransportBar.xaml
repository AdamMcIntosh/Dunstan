<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Dustan.Controls.TransportBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Dustan.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:PercentValueConverter x:Key="PercentTipConverter" />
    </UserControl.Resources>

    <Grid
        Padding="16,8"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        ColumnSpacing="12"
        RowSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="160" />
            <ColumnDefinition Width="3*" MinWidth="280" />
            <ColumnDefinition Width="*" MinWidth="160" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock
                x:Name="TitleText"
                FontWeight="SemiBold"
                Text="Nothing playing"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="ArtistText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text=""
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Spacing="4">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                <ToggleButton
                    x:Name="ShuffleButton"
                    Click="ShuffleButton_Click"
                    Content="&#xE8B1;"
                    FontFamily="Segoe Fluent Icons"
                    ToolTipService.ToolTip="Shuffle" />
                <Button
                    x:Name="PreviousButton"
                    Click="PreviousButton_Click"
                    Content="&#xE892;"
                    FontFamily="Segoe Fluent Icons"
                    ToolTipService.ToolTip="Previous" />
                <Button
                    x:Name="PlayPauseButton"
                    Width="44"
                    Click="PlayPauseButton_Click"
                    Content="&#xE768;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="18"
                    ToolTipService.ToolTip="Play/Pause" />
                <Button
                    x:Name="NextButton"
                    Click="NextButton_Click"
                    Content="&#xE893;"
                    FontFamily="Segoe Fluent Icons"
                    ToolTipService.ToolTip="Next" />
                <Button
                    x:Name="RepeatModeButton"
                    Click="RepeatModeButton_Click"
                    Content="&#xE8EE;"
                    FontFamily="Segoe Fluent Icons"
                    ToolTipService.ToolTip="Repeat: Off" />
            </StackPanel>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PositionText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="0:00" />
                <Slider
                    x:Name="SeekSlider"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0"
                    PointerCaptureLost="SeekSlider_PointerCaptureLost"
                    PointerPressed="SeekSlider_PointerPressed"
                    ValueChanged="SeekSlider_ValueChanged" />
                <TextBlock
                    x:Name="DurationText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="0:00" />
            </Grid>
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE767;" />
            <Slider
                x:Name="VolumeSlider"
                Width="120"
                VerticalAlignment="Center"
                Maximum="100"
                Minimum="0"
                StepFrequency="1"
                ThumbToolTipValueConverter="{StaticResource PercentTipConverter}"
                ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock
                x:Name="VolumePercentText"
                MinWidth="36"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="80%" />
        </StackPanel>
    </Grid>
</UserControl>
